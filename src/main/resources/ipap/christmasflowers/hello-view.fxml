<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>

<VBox alignment="CENTER" prefHeight="330" prefWidth="520" spacing="18" xmlns="http://javafx.com/javafx/26"
      xmlns:fx="http://javafx.com/fxml/1" fx:controller="ipap.christmasflowers.HelloController">

    <padding>
        <Insets bottom="24" left="24" right="24" top="24"/>
    </padding>

    <Label style="-fx-font-size: 22px; -fx-font-weight: bold;" text="Цветочки в рождественскую ночь"/>

    <HBox alignment="CENTER" spacing="42">
        <VBox alignment="CENTER" spacing="8">
            <Circle fx:id="leftCircle" radius="34"/>
            <Label fx:id="leftName" text="Герань (G)"/>
        </VBox>

        <VBox alignment="CENTER" spacing="8">
            <Circle fx:id="centerCircle" radius="34"/>
            <Label fx:id="centerName" text="Крокус (C)"/>
        </VBox>

        <VBox alignment="CENTER" spacing="8">
            <Circle fx:id="rightCircle" radius="34"/>
            <Label fx:id="rightName" text="Фиалка (V)"/>
        </VBox>
    </HBox>

    <HBox alignment="CENTER" spacing="10">
        <Label text="Сколько уже прошло дней?"/>
        <TextField fx:id="daysField" prefWidth="120" promptText="1,2 или 73"/>
        <Button onAction="#onCalculateClick" text="Посмотреть цветочки"/>
    </HBox>

    <Label fx:id="messageLabel" text="Введите число дней" wrapText="true"/>
</VBox>
